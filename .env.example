# Copy to .env and fill in. NEVER commit .env.

# --- CognoDB Cloud (Bolt) ---
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# --- Neo4j AuraDB Free (Bolt) ---
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Memgraph Cloud (Bolt) ---
MEMGRAPH_URI=bolt+s://<host>:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# --- ArangoDB Oasis (HTTP) ---
ARANGO_URL=https://<host>.arangodb.cloud:8529
ARANGO_DB=benchmark
ARANGO_USER=root
ARANGO_PASSWORD=

# --- JanusGraph (self-hosted Gremlin, capped in Docker) ---
JANUS_URL=ws://localhost:8182/gremlin

# --- Bench tunables ---
BENCH_DATASET=data/processed/pokec_200k
BENCH_ITERATIONS=100
BENCH_WARMUP=20
BENCH_CONCURRENCY=1,10,40
BENCH_RW_MIX=80  # % reads
BENCH_SEED=42
